# Server_SUS - credenciais dos programas do DATASUS operados na VM.
# NUNCA compartilhe este arquivo.

# Programas do DATASUS operados pelo robo (dentro da VM)
SISAIH01_USUARIO=mestre
SISAIH01_SENHA=mestre
SIHD_USUARIO=
SIHD_SENHA=
FPO_USUARIO=mestre
FPO_SENHA=A

# Transmissor DATASUS (envio do .DTS): CPF e senha do secretário de saúde (gestor)
TIPO_ARQUIVO=SIHD
IBGE=150175
SECRETARIO_CPF=
SECRETARIO_SENHA=

# Token da API do Server_SUS (o AutoSUS usa o mesmo valor). Gere um novo com:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVER_SUS_TOKEN=
