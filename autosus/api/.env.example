# AutoSUS - API (NestJS). Copie para .env e preencha. NUNCA compartilhe o .env.

# PostgreSQL local
DATABASE_URL="postgresql://autosus:SENHA@localhost:5432/autosus?schema=public"

# Segredo para assinar o login (JWT). Gere um com:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SEGREDO=

# Administrador criado na primeira subida (quando o banco não tem usuários)
ADMIN_EMAIL=
ADMIN_SENHA=
ADMIN_NOME=Administrador

# Porta da API (só 127.0.0.1); o Next.js repassa /api/* para ela
PORT=3001

# Opcional: agenda do downloader pelo AutoSUS (cron). Vazio = a tarefa agendada do Windows continua
# fazendo isso. Ex.: "0 10 * * *" (todo dia às 10h)
ATUALIZACOES_AGENDA=

# Opcional: onde ficam o downloader e o Python (padrão: ../downloads e C:\AutoSUS\.venv)
# AUTOSUS_DOWNLOADS=
# PYTHON=
