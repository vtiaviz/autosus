# Copie este arquivo para ".env" (o instalar.bat faz isso) e preencha.
# NUNCA compartilhe o arquivo .env.

# Portal do gestor CNES (TXTPROC)
CNES_USUARIO=
CNES_SENHA=
CNES_CPF=

# Gmail para o aviso por e-mail.
# A senha de app e gerada em https://myaccount.google.com/apppasswords
# (exige verificacao em duas etapas ativa). Cole os 16 caracteres sem espacos.
GMAIL_USUARIO=vti.aviz@gmail.com
GMAIL_SENHA_APP=

# WebAIH (aih.saudebga.top): use o login do usuario que cadastra os formularios,
# pois a exportacao traz so as AIHs desse usuario.
WEBAIH_USUARIO=
WEBAIH_SENHA=
